<odoo>
    <record id="contract_contract_form_view" model="ir.ui.view">
        <field name="model">contract.contract</field>
        <field
            name="inherit_id"
            ref="contract_document_template.contract_contract_form_view"
        />
        <field name="arch" type="xml">
            <button name="action_generate_documents" position="after">
                <button
                    name="action_send_for_signature"
                    type="object"
                    string="Send documents for signature"
                    class="btn-primary ms-2"
                    icon="fa-pencil"
                    confirm="The documents not signed nor sent yet will be generated, frozen and sent for signature. Continue?"
                />
                <span class="ms-3" invisible="not sign_state">
                    <field
                        name="sign_state"
                        widget="badge"
                        decoration-info="sign_state == 'sent'"
                        decoration-success="sign_state == 'signed'"
                        decoration-muted="sign_state == 'not_sent'"
                    />
                    <field name="sign_summary" class="ms-2 text-muted" />
                </span>
            </button>
            <xpath
                expr="//field[@name='document_ids']/list/field[@name='state']"
                position="after"
            >
                <field
                    name="sign_state"
                    widget="badge"
                    decoration-info="sign_state == 'sent'"
                    decoration-success="sign_state == 'signed'"
                />
                <field name="sign_required" optional="show" />
                <field name="signed_on" optional="hide" />
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="sign_blocked" invisible="1" />
                <div class="alert alert-info" role="status" invisible="not sign_blocked">
                    This contract will not be invoiced until the documents required
                    to invoice are signed.
                </div>
            </xpath>
        </field>
    </record>

    <record id="contract_contract_tree_view" model="ir.ui.view">
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_tree_view" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field
                    name="sign_state"
                    widget="badge"
                    optional="show"
                    decoration-info="sign_state == 'sent'"
                    decoration-success="sign_state == 'signed'"
                />
                <field name="sign_summary" optional="hide" />
            </field>
        </field>
    </record>
</odoo>
