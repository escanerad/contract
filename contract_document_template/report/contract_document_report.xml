<odoo>
    <record id="report_contract_document" model="ir.actions.report">
        <field name="name">Contract document</field>
        <field name="model">contract.document</field>
        <field name="report_type">qweb-pdf</field>
        <field
            name="report_name"
        >contract_document_template.report_contract_document_template</field>
        <field name="print_report_name">('%s - %s' % (object.name, object.title or '')).replace('/', '-')</field>
        <field name="binding_model_id" ref="model_contract_document" />
        <field name="binding_type">report</field>
    </record>

    <template id="report_contract_document_page">
        <t t-call="web.external_layout">
            <div class="page o_contract_document">
                <div t-if="o.document_html" t-out="o.document_html" />
                <p t-else="" class="text-muted">
                    <em>The document has not been generated yet.</em>
                </p>

                <t t-if="o.template_id.include_line_table and o.contract_line_ids">
                    <h4 class="mt-4">Economic conditions</h4>
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th class="text-end">Quantity</th>
                                <th class="text-end">Unit price</th>
                                <th>Recurrence</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t
                                t-foreach="o.contract_line_ids.filtered(lambda l: not l.is_canceled)"
                                t-as="line"
                            >
                                <tr t-if="line.display_type == 'line_section'">
                                    <td colspan="5"><strong t-field="line.name" /></td>
                                </tr>
                                <tr t-elif="line.display_type == 'line_note'">
                                    <td colspan="5"><em t-field="line.name" /></td>
                                </tr>
                                <tr t-else="">
                                    <td><span t-field="line.name" /></td>
                                    <td class="text-end"><span t-field="line.quantity" /></td>
                                    <td class="text-end">
                                        <span
                                            t-field="line.price_unit"
                                            t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"
                                        />
                                    </td>
                                    <td>
                                        <span t-field="line.recurring_interval" />
                                        <span t-field="line.recurring_rule_type" />
                                    </td>
                                    <td class="text-end">
                                        <span
                                            t-field="line.price_subtotal"
                                            t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"
                                        />
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </t>

                <t t-if="o.template_id.include_signature_page">
                    <div style="page-break-before: always;" />
                    <!-- Signature page: always the LAST page of the document.
                         Boxes are at fixed percentages of the page so that an
                         e-signature module can place its fields on them. -->
                    <div class="o_contract_signatures" style="margin-top: 2cm;">
                        <h4>Signatures</h4>
                        <p>
                            In witness whereof, the parties sign this document.
                        </p>
                        <table style="width: 100%; margin-top: 1cm;">
                            <tr>
                                <td style="width: 48%; vertical-align: top;">
                                    <strong t-out="o.company_id.name" />
                                    <div
                                        class="o_contract_sign_box_company"
                                        style="height: 3.5cm; border: 1px solid #999; margin-top: 0.3cm;"
                                    />
                                </td>
                                <td style="width: 4%;" />
                                <td style="width: 48%; vertical-align: top;">
                                    <strong t-out="o.partner_id.commercial_partner_id.name" />
                                    <div
                                        class="o_contract_sign_box_partner"
                                        style="height: 3.5cm; border: 1px solid #999; margin-top: 0.3cm;"
                                    />
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <template id="report_contract_document_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t
                    t-call="contract_document_template.report_contract_document_page"
                    t-lang="o.partner_id.lang"
                />
            </t>
        </t>
    </template>
</odoo>
