<odoo>
    <record id="contract_document_template_form_view" model="ir.ui.view">
        <field name="model">contract.document.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="title" placeholder="{{ object.name }}" />
                            <field name="document_type" />
                            <field
                                name="lang"
                                placeholder="{{ object.partner_id.lang }}"
                            />
                            <field name="active" invisible="1" />
                        </group>
                        <group>
                            <field name="include_line_table" />
                            <field name="include_signature_page" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                    </group>
                    <notebook>
                        <page name="body" string="Body">
                            <field name="body" options="{'codeview': true}" />
                        </page>
                        <page name="clauses" string="Clauses">
                            <field name="clause_ids">
                                <list>
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field name="numbered" />
                                </list>
                            </field>
                        </page>
                        <page name="annexes" string="Annexes">
                            <field name="annex_ids">
                                <list>
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="contract_document_template_list_view" model="ir.ui.view">
        <field name="model">contract.document.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="document_type" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="contract_document_template_action" model="ir.actions.act_window">
        <field name="name">Contract Document Templates</field>
        <field name="res_model">contract.document.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="contract_document_template_menu"
        action="contract_document_template_action"
        parent="contract.menu_config_contract"
        sequence="20"
    />
</odoo>
